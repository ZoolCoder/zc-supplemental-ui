{{zc-init}}<!DOCTYPE html>
<html lang="{{@root.zc.lang}}" dir="{{@root.zc.dir}}" data-theme="auto">
<head>
{{> head}}
</head>
<body class="zc-docs{{#with page.attributes.role}} {{this}}{{/with}}">
<a class="skip" href="#main">{{t "skip"}}</a>
<div class="shell">
<div class="scrim" data-scrim hidden></div>
{{> side}}
<div class="body">
{{> hdr}}
<main id="main" tabindex="-1">
{{#if (eq page.layout '404')}}
{{> page-404}}
{{else}}
{{> page}}
{{/if}}
</main>
{{> footer}}
</div>
</div>
<button class="iconbtn totop" type="button" data-totop aria-label="{{t "backToTop"}}" title="{{t "backToTop"}}" hidden>{{{icon "arrow"}}}</button>
<dialog class="zoom" id="zc-zoom" aria-label="{{t "image"}}"><form method="dialog"><button class="zoomshut" aria-label="{{t "close"}}"><img alt=""></button></form></dialog>
{{> keys}}
{{> scripts}}
</body>
</html>
