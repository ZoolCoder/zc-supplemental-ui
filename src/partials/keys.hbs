<dialog class="palette keys" id="zc-keys" aria-labelledby="zc-keys-h">
  <h2 id="zc-keys-h">Keyboard shortcuts</h2>
  <dl>
    <dt><kbd>Ctrl</kbd>/<kbd>⌘</kbd> <kbd>K</kbd> or <kbd>/</kbd></dt><dd>Search the docs</dd>
    <dt><kbd>←</kbd> <kbd>→</kbd></dt><dd>Previous or next page</dd>
    <dt><kbd>g</kbd> <kbd>h</kbd></dt><dd>Home</dd>
    <dt><kbd>t</kbd></dt><dd>Cycle the theme</dd>
    <dt><kbd>?</kbd></dt><dd>This list</dd>
    <dt><kbd>Esc</kbd></dt><dd>Close a menu or the search results</dd>
  </dl>
  <form method="dialog"><button class="btn mini">Close</button></form>
</dialog>
