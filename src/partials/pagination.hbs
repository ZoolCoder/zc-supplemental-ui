{{#unless (eq page.attributes.pagination undefined)}}
{{#if (or page.previous page.next)}}
<nav class="pager" aria-label="{{t "pager"}}">
{{#with page.previous}}
  <a class="prev" href="{{{relativize ./url}}}" rel="prev"><small>{{t "previous"}}</small><b>{{{./content}}}</b></a>
{{/with}}
{{#with page.next}}
  <a class="next" href="{{{relativize ./url}}}" rel="next"><small>{{t "next"}}</small><b>{{{./content}}}</b></a>
{{/with}}
</nav>
{{/if}}
{{/unless}}
