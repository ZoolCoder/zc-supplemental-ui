<meta charset="utf-8">
{{!-- GitHub Pages and other static hosts cannot send headers, so the policy
     travels in the page. Everything is served by the site itself; page-zc-csp
     replaces the policy for a site that embeds something from elsewhere. --}}
<meta http-equiv="Content-Security-Policy" content="{{#if page.attributes.zc-csp}}{{page.attributes.zc-csp}}{{else}}default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'{{/if}}">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{{detag (or page.title (t "notFound"))}}}{{#with site.title}} · {{this}}{{/with}}</title>
{{#with page.canonicalUrl}}
<link rel="canonical" href="{{{this}}}">
{{/with}}
{{#with page.description}}
<meta name="description" content="{{{detag this}}}">
{{/with}}
{{#with page.keywords}}
<meta name="keywords" content="{{{this}}}">
{{/with}}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{site.title}}">
<meta property="og:title" content="{{{detag (or page.title site.title)}}}">
{{#with page.description}}
<meta property="og:description" content="{{{detag this}}}">
{{/with}}
{{#with page.canonicalUrl}}
<meta property="og:url" content="{{{this}}}">
{{/with}}
<meta property="og:locale" content="{{@root.zc.lang}}">
{{#with page.attributes.zc-og-image}}
<meta property="og:image" content="{{{this}}}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
{{/with}}
{{#each @root.zc.langs}}
<link rel="alternate" hreflang="{{./lang}}" href="{{#if ./absoluteUrl}}{{{./absoluteUrl}}}{{else}}{{{relativize ./url}}}{{/if}}">
{{/each}}
{{#with (or antoraVersion site.antoraVersion)}}
<meta name="generator" content="Antora {{this}}">
{{/with}}
{{> head-theme}}
<link rel="stylesheet" href="{{{uiRootPath}}}/css/site.css">
<link rel="icon" href="{{{uiRootPath}}}/img/mark.svg" type="image/svg+xml">
{{#with page.previous}}
<link rel="prev" href="{{{relativize ./url}}}">
{{/with}}
{{#with page.next}}
<link rel="next" href="{{{relativize ./url}}}">
{{/with}}
