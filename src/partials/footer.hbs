<footer class="foot">
  <div class="foot-in">
    <span class="foot-brand">{{> mark}}<span>{{site.title}}{{#with page.attributes.zc-owner}} · {{t "by"}} <a href="{{{or @root.page.attributes.zc-site '#'}}}">{{this}}</a>{{/with}}</span></span>
    <span class="grow"></span>
{{#with page.attributes.zc-repo}}
    <a href="{{{this}}}">{{t "source"}}</a>
    <a href="{{{this}}}/issues">{{t "issues"}}</a>
    <a href="{{{this}}}/releases">{{t "releases"}}</a>
{{/with}}
    <span class="muted">{{or page.attributes.zc-license (t "license")}} · © {{year}}</span>
  </div>
</footer>
