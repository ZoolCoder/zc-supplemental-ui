{{#if page.breadcrumbs}}
<nav class="crumb" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{{relativize (or site.homeUrl '/')}}}">{{or page.component.title site.title}}</a></li>
{{#each page.breadcrumbs}}
{{#unless @last}}
    <li>{{#if (and ./url (eq ./urlType 'fragment'))}}<a href="{{{./url}}}">{{{./content}}}</a>{{else if ./url}}<a href="{{{relativize ./url}}}">{{{./content}}}</a>{{else}}{{{./content}}}{{/if}}</li>
{{/unless}}
{{/each}}
  </ol>
</nav>
{{/if}}
