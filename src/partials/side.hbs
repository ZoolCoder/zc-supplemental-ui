<aside class="side" id="zc-side" aria-label="{{t "docs"}}">
  <div class="sidetop">
    {{> brand}}
    <button class="iconbtn sideclose" type="button" data-drawer-close aria-label="{{t "closeMenu"}}">{{{icon "close"}}}</button>
  </div>
{{> versions}}
  <nav class="docnav" aria-label="{{t "pages"}}">
{{#each page.navigation}}
    {{#if ./content}}<p class="navh">{{{./content}}}</p>{{/if}}
{{> nav-items items=./items depth=0}}
{{/each}}
  </nav>
  <div class="side-foot">
    {{#with page.attributes.zc-repo}}<a class="led" href="{{{this}}}"><i></i><span class="lbl">{{t "openSource"}}<small>{{or @root.page.attributes.zc-license (t "license")}}</small></span></a>{{/with}}
  </div>
</aside>
