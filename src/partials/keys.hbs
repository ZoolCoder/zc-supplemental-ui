<dialog class="palette keys" id="zc-keys" aria-labelledby="zc-keys-h">
  <h2 id="zc-keys-h">{{t "shortcuts"}}</h2>
  <dl>
    <dt><kbd>Ctrl</kbd>/<kbd>⌘</kbd> <kbd>K</kbd> {{t "or"}} <kbd>/</kbd></dt><dd>{{t "keysSearch"}}</dd>
    <dt><kbd>↑</kbd> <kbd>↓</kbd> <kbd>Enter</kbd></dt><dd>{{t "keysResults"}}</dd>
    <dt><kbd>{{t "prevKey"}}</kbd> <kbd>{{t "nextKey"}}</kbd></dt><dd>{{t "keysPage"}}</dd>
    <dt><kbd>f</kbd></dt><dd>{{t "keysFilter"}}</dd>
    <dt><kbd>g</kbd> <kbd>h</kbd></dt><dd>{{t "keysHome"}}</dd>
    <dt><kbd>t</kbd></dt><dd>{{t "keysTheme"}}</dd>
    <dt><kbd>?</kbd></dt><dd>{{t "keysList"}}</dd>
    <dt><kbd>Esc</kbd></dt><dd>{{t "keysEsc"}}</dd>
  </dl>
  <form method="dialog"><button class="btn mini">{{t "close"}}</button></form>
</dialog>
