{{#with page.attributes.zc-md}}
<div class="doc-meta">
  <button class="btn mini" type="button" data-copy-md="{{{relativize this}}}">{{{icon "copy"}}}<span>{{t "copyPage"}}</span></button>
  <a class="btn mini" href="{{{relativize this}}}" title="{{t "markdownTitle"}}" type="text/markdown">{{{icon "markdown"}}}<span dir="ltr">.md</span></a>
</div>
{{/with}}
